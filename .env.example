# Local environment configuration. Copy to .env and fill in real values.
# Never commit .env.

PORT=3000
NODE_ENV=development
FRONTEND_URL=*

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

SKYNAV_API_URL=https://api.skynav.in/v1
SKYNAV_BEARER_TOKEN=your-bearer-token-here
SKYNAV_USERNAME=your-username
SKYNAV_PASSWORD=your-password
SKYNAV_PROJECT_ID=your-project-id
SKYNAV_COMPANY_NAME=your-company-name
SKYNAV_IMEI=
GPS_POLL_INTERVAL_MS=60000

VITE_GOOGLE_MAPS_KEY=your-google-maps-key-here